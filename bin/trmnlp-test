#!/usr/bin/env bash
# Runs trmnlp-test in Docker against a plugin repository (default: the current directory).
#   trmnlp-test [run|init|models|versions|refresh|shell|help] [args] [-- spec args]
# --repo DIR, --mount DIR and --env NAME[=VALUE] are taken from anywhere before `--`.
# TRMNLP_TEST_BUILD=1 rebuilds the image on the newest trmnlp; TRMNLP_VERSION=x.y.z picks another.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
IMAGE="${TRMNLP_TEST_IMAGE:-trmnlp-test:latest}"
REPO="$PWD"
MOUNTS=()
ENVS=(-e CI -e FORCE_COLOR)
for k in $(compgen -e | grep '^TRMNLP_TEST_' || true); do ENVS+=(-e "$k"); done
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) ARGS+=("$@"); break ;;
    --repo) REPO="$(realpath "$2")"; shift 2 ;;
    --mount) MOUNTS+=(-v "$(realpath "$2"):$(realpath "$2")"); shift 2 ;;
    --env) ENVS+=(-e "$2"); shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
if [[ "${TRMNLP_TEST_BUILD:-}" == 1 ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  # the newest trmnlp release unless TRMNLP_VERSION picks one
  V="${TRMNLP_VERSION:-$(curl -fsS https://rubygems.org/api/v1/versions/trmnl_preview/latest.json 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')}"
  docker build --build-arg "TRMNLP_VERSION=${V:-0.14.2}" -t "$IMAGE" "$HERE" >&2
fi
CACHE="${TRMNLP_TEST_CACHE_DIR:-$HOME/.cache/trmnlp-test}"
mkdir -p "$CACHE"
TTY=(); [[ -t 1 ]] && TTY=(-t)
ENTRY=(); if [[ "${1:-}" == shell ]]; then shift; ENTRY=(--entrypoint bash); fi
[[ "${1:-}" == update ]] && { echo "trmnlp-test: from a clone, rebuild with TRMNLP_TEST_BUILD=1" >&2; exit 0; }
exec docker run --rm -i "${TTY[@]}" --init --ipc=host -u "$(id -u):$(id -g)" \
  -v "$REPO:$REPO" -w "$REPO" -v "$CACHE:/cache" "${MOUNTS[@]}" \
  "${ENVS[@]}" "${ENTRY[@]}" "$IMAGE" "$@"
