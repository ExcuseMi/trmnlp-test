#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs trmnlp-test (a Docker image) against a TRMNL plugin repository.
#   trmnlp-test [--repo DIR] [--mount DIR]... [run|init|models|versions|refresh|update|shell|version] [playwright args]
require 'etc'
require 'fileutils'
require_relative '../lib/trmnlp_test/version'

# :latest follows the newest trmnlp release; TRMNLP_TEST_IMAGE pins one (e.g. ...:trmnlp-0.13.1)
image = ENV.fetch('TRMNLP_TEST_IMAGE', "#{TrmnlpTest::IMAGE}:latest")
repo = Dir.pwd
mounts = []
args = ARGV.dup
while %w[--repo --mount].include?(args.first)
  flag, dir = args.shift(2)
  abort "trmnlp-test: #{flag} needs a directory" unless dir
  path = File.realpath(dir)
  flag == '--repo' ? repo = path : mounts += ['-v', "#{path}:#{path}"]
end

USAGE = File.read(File.expand_path('../lib/trmnlp_test/usage.txt', __dir__))
args[0] = { '-h' => 'help', '--help' => 'help', '-v' => 'version', '--version' => 'version' }.fetch(args[0], args[0]) if args.any?
case args.first
when 'help'
  puts USAGE
  exit
when 'version'
  puts "launcher #{TrmnlpTest::VERSION}, image #{image}"
  if system('docker', 'image', 'inspect', image, out: File::NULL, err: File::NULL)
    exec 'docker', 'run', '--rm', image, 'version'
  else
    puts 'image not pulled yet (trmnlp-test update)'
  end
  exit
when 'update'
  exec 'docker', 'pull', image
end

abort 'trmnlp-test needs Docker: https://docs.docker.com/get-docker/' unless system('docker info', out: File::NULL, err: File::NULL)

cache = ENV.fetch('TRMNLP_TEST_CACHE_DIR', File.join(Dir.home, '.cache', 'trmnlp-test'))
FileUtils.mkdir_p(cache)

# a missing image is pulled; a :latest image is refreshed at most once a day
present = system('docker', 'image', 'inspect', image, out: File::NULL, err: File::NULL)
# the stamp names the launcher version too: a new launcher pulls at once, it may need a newer image
stamp = File.join(cache, ".pulled-#{TrmnlpTest::VERSION}-" + image.gsub(/[^A-Za-z0-9.]+/, '_'))
stale = image.end_with?(':latest') && (!File.exist?(stamp) || Time.now - File.mtime(stamp) > 86_400)
if !present || (stale && !ENV['TRMNLP_TEST_NO_PULL'])
  warn "trmnlp-test: pulling #{image}" unless present
  pulled = system('docker', 'pull', '-q', image, out: File::NULL, err: present ? File::NULL : $stderr)
  abort("trmnlp-test: could not pull #{image}") if !pulled && !present
  FileUtils.touch(stamp) # checked today, whether or not the registry had it
end
entry = []
if args.first == 'shell'
  args.shift
  entry = ['--entrypoint', 'bash']
end
tty = $stdout.tty? ? ['-t'] : []
env = %w[CI TRMNLP_TEST_DEBUG TRMNLP_TEST_WORKERS TRMNLP_TEST_SHOW_DIFFERENCES FORCE_COLOR].flat_map { |k| ['-e', k] }
exec 'docker', 'run', '--rm', '-i', *tty, '--init', '--ipc=host', '-u', "#{Process.uid}:#{Process.gid}",
     '-v', "#{repo}:#{repo}", '-w', repo, '-v', "#{cache}:/cache", *mounts, *env, *entry, image, *args
